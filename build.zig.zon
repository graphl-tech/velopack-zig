.{
    .name = .velopack_zig,
    .fingerprint = 0x95d249847186372f,

    // Wraps the prebuilt Velopack C-ABI archives published at
    // https://github.com/velopack/velopack/releases plus Zig-built mksquashfs
    // (squashfs-tools + zlib) for `vpk pack` on Linux.
    .version = "0.0.1",
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // Prebuilt C-ABI archives for every supported triple. Same release
        // pixi currently uses; bump in lockstep so both consumers see the
        // same Velopack runtime version.
        .velopack = .{
            .url = "https://github.com/velopack/velopack/releases/download/0.0.1589-ga2c5a97/velopack_libc_0.0.1589-ga2c5a97.zip",
            .hash = "N-V-__8AAGLSaQX1RqiiyJ0wx1tREvLoiEyH-NHb0YTvjMzW",
        },
        // Zig build of mksquashfs (+ unsquashfs) from upstream squashfs-tools.
        // Lazy — only fetched when buildMksquashfs() is called on a Linux host.
        .squashfs = .{
            .path = "squashfs",
            .lazy = true,
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "squashfs",
        "tools",
        "README.md",
        "LICENSE",
    },
}
