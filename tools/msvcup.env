# Pinned msvcup release + package set.  Sourced by setup-msvc.{sh,ps1}.
MSVCUP_TAG=v2026_04_08
# No `autoenv`: it drags in sdk-10.0.26100.15, whose shared/ headers are broken
# in msvcup (only 9 files, missing winapifamily.h) — which then becomes the
# highest-versioned SDK that gen_zig_libc_msvc.zig picks, breaking the build.
MSVCUP_PACKAGES="msvc-14.44.17.14 sdk-10.0.22621.7"

# SDL builds its GameInput backend unconditionally for windows-msvc and needs
# GameInput.h, which ships only in sdk-10.0.26100.x. That SDK can't be the base
# (broken shared/, see above), so setup-msvc installs this package to a throwaway
# dir and copies just GameInput.h into the base SDK's um/. Empty disables this.
MSVCUP_GAMEINPUT_PACKAGE=sdk-10.0.26100.15
